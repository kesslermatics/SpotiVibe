# ── Database ──────────────────────────────────────────
# PostgreSQL connection string.
# Local: postgresql://user:password@localhost:5432/vibeswipe
# Railway: Use the connection string from your Railway dashboard → PostgreSQL service → "Connect" tab
DATABASE_URL=postgresql://user:password@localhost:5432/vibeswipe

# ── JWT ───────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Spotify ───────────────────────────────────────────
# Get your Client ID & Secret from: https://developer.spotify.com/dashboard → Create App
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Must match the redirect URI configured in your Spotify App settings
SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# ── OpenAI AI ─────────────────────────────────────────
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Music curation: Discover, Daily Drive/Walk, Gym Playlist, Swipe Deck
OPENAI_CURATION_MODEL=gpt-6.1-sol
# Focused utilities: Vibe Roast and Spotify-match QA
OPENAI_UTILITY_MODEL=gpt-6-luna
# Playlist-cover generation uses OpenAI's dedicated image model.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
